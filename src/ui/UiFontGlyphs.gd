## Where a sentence needs a different drawing than a damage number: the comma hangs a tail so it is not a period.
const OVERRIDES := {
	",": ["..", "..", "..", "..", "..", ".#", ".#", "#.", ".."],
}

## Characters that are the same drawing as another one (typographic quotes in dialogue, the multiply sign).
const ALIASES := {
	"’": "'", "‘": "'", "“": "\"", "”": "\"", "×": "x", "►": "▶", "◄": "◀", "✕": "✗", "−": "-",
}
