extends RefCounted
class_name UiFontGlyphs

## The rest of the pixel face: PixelText.GLYPHS holds the capitals, digits and battle punctuation the damage
## numbers were drawn with; this table adds what a whole UI needs (lowercase, the punctuation of paths, keys and
## sentences, the menu arrows). Same hand: 5 columns at most, 7 rows from cap top to baseline. A glyph with NINE
## rows hangs its last two below the baseline (g j p q y , ; _).
## PixelText keeps drawing from its own table, so a damage number never changes because a menu needed a letter.

const ROWS := 7
const DESCENT_ROWS := 2

const GLYPHS := {
	"a": [".....", ".....", ".###.", "....#", ".####", "#...#", ".####"],
	"b": ["#....", "#....", "####.", "#...#", "#...#", "#...#", "####."],
