tmp/


# Music pipeline - keep OGG, ignore raw downloads and locks
assets/audio/music/*.mp3
assets/audio/music/*.wav
*.lock
captcha-key.txt
__pycache__/
tools/test_*.py

# Sprite pipeline intermediates — written by palette_lock.py /
# normalize_sprites.py as rollback backups. Not shipped (web
# export_presets excludes them via *.pre_*.png), not referenced by
# any manifest, and they belong to the cowir-sprites worktree.
# Excluded from git so the game repo doesn't carry ~70MB of derived
# artifacts, and so cowir-sprites can leave locally-usable backups
# in their working tree without dirtying commits here.
assets/sprites/**/*.pre_normalize.png
assets/sprites/**/*.pre_palette.png
assets/sprites/**/*.pre_chromakey.png
assets/sprites/**/*.pre_artist_style.png
*.bak

# Scraped third-party sprite sets used as LoRA training input — NEVER commit.
# Filenames name commercial titles (Final Fantasy Tactics/VI); provenance is not ours.
tools/lora_training/jrpg_flat/

# Sprite-gen lane additions (PR #5 fold 2026-08-17)
# LoRA training — large binary assets and generated datasets
tools/lora_training/raw_jrpg_sprites/
tools/lora_training/raw_jrpg_sprites_flat/
tools/lora_training/style_dataset/
tools/lora_training/kohya_dataset/
tools/lora_training/checkpoints/
tools/lora_training/logs/
tools/lora_training/samples/
tools/lora_training/dataset/
tools/lora_training/dataset_info.json
tools/__pycache__/
uv.lock
# Artist source files mirrored from Google Drive (canonical lives on gdrive)
assets/sprites/drive_archive/


# *_sdxl/hero_reference.png are IP-Adapter identity INPUTS read by tools/gen_sprite_sdxl.py,
# not game assets. Godot imports them anyway and mints a fresh uid per worktree (measured:
# 4 worktrees, 4 uids), so tracking the sidecar would block every other tree's next merge.
assets/sprites/jobs/*_sdxl/hero_reference.png.import
