+# --- cowir patch: local-only guard (outermost middleware, runs before CORS) ---
+# Players' servers expose ONLY the two OpenAI-compatible voice endpoints, refuse any request carrying an
+# Origin header (browsers send one cross-origin; Godot's HTTPRequest never does) and any Host that is not
+# loopback (defeats DNS rebinding). COWIR_TTS_DEV=1 re-opens the other routes for local tuning only;
+# the Origin and Host checks apply regardless.
+_COWIR_ALLOWED = {("POST", "/v1/audio/speech"), ("GET", "/v1/audio/voices")}
+
+
+@app.middleware("http")
+async def _cowir_local_guard(request: Request, call_next):
+    if request.headers.get("origin") is not None:
+        return JSONResponse({"detail": "cross-origin requests are refused"}, status_code=403)
+    host = request.headers.get("host", "").rsplit(":", 1)[0].strip("[]").lower()
+    if host not in ("127.0.0.1", "localhost", "::1"):
+        return JSONResponse({"detail": "non-loopback Host refused"}, status_code=403)
+    if os.environ.get("COWIR_TTS_DEV") != "1" and (request.method, request.url.path) not in _COWIR_ALLOWED:
+        return JSONResponse({"detail": "not found"}, status_code=404)
+    return await call_next(request)
+
+
