#!/usr/bin/env bash
# chainNNN.sh — the fold pre-gate for release @NNN@: import, render smoke, publish selftests,
# pre_ready sweep, and ONLY if all four are clean and the tree has not moved, the full gate.
# Generated by tools/fold_gate/make.sh; it replaced a ~900-character command retyped every fold.
set -u
cd @REPO@
PAUSE=/home/struktured/projects/dr_mario_rl/tmp/PAUSE_ALL
START_SHA="$(git rev-parse HEAD)"
echo "chain@NNN@ tree=$START_SHA"

XDG_DATA_HOME=$PWD/tmp/xdg timeout 900 godot --headless --audio-driver Dummy --import --quit > tmp/import@NNN@.log 2>&1
IE=$?; echo "import EC=$IE"

S=$PWD/tmp/smoke_xdg_@NNN@_$$
XDG_DATA_HOME=$S COWIR_SFX_LOG_CUES=1 xvfb-run -a timeout 300 godot --rendering-driver opengl3 --audio-driver Dummy -- --render-smoke > tmp/smoke@NNN@.log 2>&1
SE=$?; echo "smoke EC=$SE"
command grep -a -E 'VERDICT|\[GAME\] Build|\[SMOKE\] FAIL' tmp/smoke@NNN@.log
F=$(command grep -a -c 'previously freed' tmp/smoke@NNN@.log)
E=$(command grep -a -c 'SCRIPT ERROR' tmp/smoke@NNN@.log)
echo "freed: $F script errors: $E"

tools/run_publish_selftests.sh > tmp/selftests@NNN@.log 2>&1
TE=$?; echo "selftests EC=$TE"; tail -1 tmp/selftests@NNN@.log

PRE_READY_BASE="${PRE_READY_BASE:-origin/main}" tools/pre_ready_guards.sh > tmp/preready@NNN@.log 2>&1
PE=$?; echo "pre_ready EC=$PE"
command grep -a -E 'distinct guards|^ *(Passing|Failing)' tmp/preready@NNN@.log
if [ "$PE" -ne 0 ]; then
  echo "failing guards:"
  sed 's/\x1b\[[0-9;]*m//g' tmp/preready@NNN@.log | command grep -a -B6 '\[Failed\]' | command grep -a -E '^res://|\[Failed\]' | head -20
fi

WHY=""
[ "$IE" -eq 0 ] || WHY="$WHY import"
[ "$SE" -eq 0 ] && command grep -aq 'VERDICT: PASS' tmp/smoke@NNN@.log || WHY="$WHY smoke"
[ "$F" = 0 ] && [ "$E" = 0 ] || WHY="$WHY smoke-errors"
[ "$TE" -eq 0 ] || WHY="$WHY selftests"
[ "$PE" -eq 0 ] || WHY="$WHY sweep"
[ -z "$(git status --porcelain)" ] || WHY="$WHY dirty"
[ "$(git rev-parse HEAD)" = "$START_SHA" ] || WHY="$WHY tree-moved"
if [ -n "$WHY" ]; then
  echo "PRE-GATE RED (${WHY# }) — gate NOT started"
  exit 1
fi

touch "$PAUSE"
bash tmp/rungate@NNN@.sh > tmp/rungate@NNN@.out 2>&1
rm -f "$PAUSE"
tail -14 tmp/rungate@NNN@.out
## rungate always exits 0 (its last line is an echo): the verdict is the gate's own EC line.
GE=$(sed -n 's/^GATE@NNN@ EC=\([0-9]*\).*/\1/p' tmp/gate@NNN@.out 2>/dev/null | tail -1)
[ -n "$GE" ] || { echo "GATE VERDICT MISSING — no 'GATE@NNN@ EC=' line in tmp/gate@NNN@.out"; exit 3; }
echo "GATE VERDICT EC=$GE"
exit "$GE"
