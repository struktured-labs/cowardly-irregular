#!/usr/bin/env bash
# chainNNN.sh — the fold pre-gate for release @NNN@: import, render smoke, the corpus runner's
# own arms, publish selftests, pre_ready sweep, and ONLY if every one of them is clean and the
# tree has not moved, the full gate.
# Generated by tools/fold_gate/make.sh; it replaced a ~900-character command retyped every fold.
set -u
cd @REPO@
## The shared box marker (tools/box_busy.sh reads it): written FIRST, removed on ANY exit.
BOX_MARKER="${BOX_MARKER:-/home/struktured/projects/cowir-main/tmp/BOX_BUSY}"
mkdir -p "$(dirname "$BOX_MARKER")"
printf 'pid=%s\nwhat=chain@NNN@\nsince=%s\n' "$$" "$(date -u +%H:%M:%SZ)" > "$BOX_MARKER"
trap 'rm -f "$BOX_MARKER"' EXIT
PAUSE=/home/struktured/projects/dr_mario_rl/tmp/PAUSE_ALL
START_SHA="$(git rev-parse HEAD)"
echo "chain@NNN@ tree=$START_SHA"

## The import and smoke start engines too, so they wait for an in-flight publish exactly as rungate does (.691 crashed with 7 engines under a web publish).
publish_busy() { local d p; for d in /home/struktured/projects/cowir-deploy-wt/tmp/_detached/v3.33.*/; do [ -f "$d/publish.log" ] && [ ! -f "$d/publish.ec" ] || continue; p="$(head -1 "$d/publish.pid" 2>/dev/null)"; [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null && continue; echo "$(basename "$d")"; return 0; done; return 1; }
pw=0
while [ "$pw" -lt 3600 ]; do pb="$(publish_busy)" || break; [ "$pw" -eq 0 ] && echo "waiting for publish $pb before any engine"; sleep 20; pw=$((pw + 20)); done
if pb="$(publish_busy)"; then echo "PUBLISH WAIT EXPIRED after ${pw}s, starting beside publish $pb"; elif [ "$pw" -gt 0 ]; then echo "publish cleared after ${pw}s"; fi

XDG_DATA_HOME=$PWD/tmp/xdg timeout 900 godot --headless --audio-driver Dummy --import --quit > tmp/import@NNN@.log 2>&1
IE=$?; echo "import EC=$IE"

S=$PWD/tmp/smoke_xdg_@NNN@_$$
XDG_DATA_HOME=$S COWIR_SFX_LOG_CUES=1 xvfb-run -a timeout 300 godot --rendering-driver opengl3 --audio-driver Dummy -- --render-smoke > tmp/smoke@NNN@.log 2>&1
SE=$?; echo "smoke EC=$SE"
command grep -a -E 'VERDICT|\[GAME\] Build|\[SMOKE\] FAIL' tmp/smoke@NNN@.log
F=$(command grep -a -c 'previously freed' tmp/smoke@NNN@.log)
E=$(command grep -a -c 'SCRIPT ERROR' tmp/smoke@NNN@.log)
echo "freed: $F script errors: $E"

## The runner's OWN arms, before its verdict on the corpus is used. It is not in the derived
## corpus (the derivation walks publish_all's closure, which never names it), so this chain is the
## only thing that runs them — and its fail-OPEN direction is the silent one: a run that collides
## with a publish or another chain and VOIDs a fixture instead of refusing.
tools/run_publish_selftests.sh --selftest > tmp/rpsself@NNN@.log 2>&1
RE=$?; echo "runner selftest EC=$RE"; tail -1 tmp/rpsself@NNN@.log

tools/run_publish_selftests.sh > tmp/selftests@NNN@.log 2>&1
TE=$?; echo "selftests EC=$TE"; tail -1 tmp/selftests@NNN@.log

PRE_READY_BASE="${PRE_READY_BASE:-origin/main}" tools/pre_ready_guards.sh > tmp/preready@NNN@.log 2>&1
PE=$?; echo "pre_ready EC=$PE"
command grep -a -E 'distinct guards|^ *(Passing|Failing)' tmp/preready@NNN@.log
if [ "$PE" -ne 0 ]; then
  echo "failing guards:"
  sed 's/\x1b\[[0-9;]*m//g' tmp/preready@NNN@.log | command grep -a -B6 '\[Failed\]' | command grep -a -E '^res://|\[Failed\]' | head -20
fi

WHY=""
[ "$IE" -eq 0 ] || WHY="$WHY import"
[ "$SE" -eq 0 ] && command grep -aq 'VERDICT: PASS' tmp/smoke@NNN@.log || WHY="$WHY smoke"
[ "$F" = 0 ] && [ "$E" = 0 ] || WHY="$WHY smoke-errors"
[ "$RE" -eq 0 ] || WHY="$WHY runner-selftest"
[ "$TE" -eq 0 ] || WHY="$WHY selftests"
[ "$PE" -eq 0 ] || WHY="$WHY sweep"
[ -z "$(git status --porcelain)" ] || WHY="$WHY dirty"
[ "$(git rev-parse HEAD)" = "$START_SHA" ] || WHY="$WHY tree-moved"
if [ -n "$WHY" ]; then
  echo "PRE-GATE RED (${WHY# }) — gate NOT started"
  exit 1
fi

touch "$PAUSE"
bash tmp/rungate@NNN@.sh > tmp/rungate@NNN@.out 2>&1
rm -f "$PAUSE"
tail -14 tmp/rungate@NNN@.out
## rungate always exits 0 (its last line is an echo): the verdict is the gate's own EC line.
GE=$(sed -n 's/^GATE@NNN@ EC=\([0-9]*\).*/\1/p' tmp/gate@NNN@.out 2>/dev/null | tail -1)
[ -n "$GE" ] || { echo "GATE VERDICT MISSING — no 'GATE@NNN@ EC=' line in tmp/gate@NNN@.out"; exit 3; }
echo "GATE VERDICT EC=$GE"
exit "$GE"
