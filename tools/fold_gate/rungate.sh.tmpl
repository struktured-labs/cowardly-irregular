cd @REPO@
## Wait (bounded, 60 min) until no publish is in flight (cowir-deploy: publish.log exists and publish.ec does not) AND no godot runs. Not a load figure: ten idle sessions hold load near 9.
for i in $(seq 240); do busy=0; for d in /home/struktured/projects/cowir-deploy-wt/tmp/_detached/v3.33.*/; do [ -f "$d/publish.log" ] && [ ! -f "$d/publish.ec" ] && busy=1; done; for p in /proc/[0-9]*; do [ "$(readlink $p/exe 2>/dev/null)" = "/usr/bin/godot" ] && busy=1; done; [ $busy -eq 0 ] && break; sleep 15; done
echo "gate start load=$(cut -d' ' -f1-3 /proc/loadavg) at $(date -u +%H:%M:%SZ)"
setsid bash tmp/gate@NNN@.sh < /dev/null > /dev/null 2>&1 &
sleep 2; bash tmp/wedgewatch@NNN@.sh
for i in $(seq 120); do command grep -aq '^PAD LINE' tmp/gate@NNN@.out 2>/dev/null && break; sleep 5; done
tail -1 tmp/wedge@NNN@_watch.log; cat tmp/gate@NNN@.out; echo "stall latches: $(command grep -ac 'stall' tmp/gate@NNN@.raw)"; echo "end load=$(cut -d' ' -f1-3 /proc/loadavg)"
